{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Cleaner",
  "version": "0.1.0",
  "identifier": "com.maccleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Mac Cleaner", "width": 1180, "height": 800,
      "minWidth": 900, "minHeight": 620, "titleBarStyle": "Overlay", "hiddenTitle": true,
      "backgroundColor": "#242422"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"], "macOS": { "minimumSystemVersion": "13.0" } }
}
