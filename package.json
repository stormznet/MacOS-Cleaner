{
  "name": "mac-cleaner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "desktop": "npm run tauri -- dev",
    "bundle": "npm run tauri -- build --bundles dmg",
    "test": "node --test tests/ui.test.mjs",
    "test:webkit": "UI_ENGINE=webkit node --test tests/ui.test.mjs"
  },
  "dependencies": { "@tauri-apps/api": "^2.12.4" },
  "devDependencies": { "@tauri-apps/cli": "^2.12.3", "typescript": "^7.0.2", "vite": "^8.3.4", "@playwright/test": "^1.58.2" }
}
